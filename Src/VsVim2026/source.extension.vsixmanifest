        <Tags>vsvim</Tags>
        <Preview>true</Preview>
    </Metadata>
    <Installation>
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[19.0,21.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
